<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo_app"
    tools:context=".ui.doctor.PerfilDoctorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/azul_primario">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPerfilDoctor"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
            app:title="Mi Perfil Profesional"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos Profesionales"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/azul_primario"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPerfilDoctorNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dr. Jeraldine Murillo Sequeiros"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:drawableStart="@drawable/ic_baseline_person_24"
                android:drawablePadding="8dp"/>

            <TextView
                android:id="@+id/tvPerfilDoctorDNI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DNI: 74887566"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:drawableStart="@drawable/ic_baseline_badge_24"
                android:drawablePadding="8dp"/>

            <TextView
                android:id="@+id/tvPerfilDoctorCMP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CMP: 123457"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:drawableStart="@drawable/ic_baseline_medical_services_24"
                android:drawablePadding="8dp"/>

            <TextView
                android:id="@+id/tvPerfilDoctorEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Especialidad: Pediatría"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:drawableStart="@drawable/health_cross_24px"
                android:drawablePadding="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos de Contacto (Editable)"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/azul_primario"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Teléfono Celular"
                app:startIconDrawable="@drawable/ic_baseline_phone_24">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPerfilDoctorTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="9"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Correo Electrónico"
                app:startIconDrawable="@drawable/ic_baseline_email_24">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPerfilDoctorCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarCambiosDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Guardar Cambios"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de Documentos"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/azul_primario"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Título Universitario (PDF):"
                android:textAppearance="?attr/textAppearanceBodyMedium"/>

            <TextView
                android:id="@+id/tvPerfilDoctorNombreArchivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="titulo_cmp_12345.pdf"
                android:textStyle="bold|italic"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerTitulo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Ver"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Actualizar"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>