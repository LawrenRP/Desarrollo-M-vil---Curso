<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCita"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="1dp"
    android:layout_marginVertical="8dp"

    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCitaFechaHora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto_principal"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/event_24px"
                app:drawableTint="@color/azul_secundario"
                android:drawablePadding="8dp"
                tools:text="Lun, 20 Oct - 10:30 AM"/>

            <TextView
                android:id="@+id/tvCitaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/fondo_estado_redondeado"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="COMPLETADA"
                tools:textColor="@color/estado_completada_texto"
                tools:backgroundTint="@color/estado_completada_fondo"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gris_fondo_app"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCitaDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_principal"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textStyle="bold"
                tools:text="Dr. Alberto García"/>

            <TextView
                android:id="@+id/tvCitaEspecialidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Cardiología"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAccionesCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarCita"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar Cita"
                android:textColor="@color/colorRed" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReprogramarCita"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Reprogramar"
                android:textColor="@color/azul_secundario" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>