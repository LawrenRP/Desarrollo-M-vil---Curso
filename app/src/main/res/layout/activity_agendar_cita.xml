<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo_app"
    android:orientation="vertical"
    tools:context=".ui.paciente.AgendarCitaActivity">

    <!-- ... (Cabecero RelativeLayout sin cambios) ... -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/azul_primario">

        <ImageButton
            android:id="@+id/buttonRetrocederAgendar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_retroceder"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/blanco" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tituloAgendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendar Cita Médica"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtituloAgendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Completa los siguientes pasos"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/blanco_transparente_subtitulo" />
        </LinearLayout>

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-24dp"
        android:background="@drawable/rounded_white_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- ... (Pasos 1 y 2 de Especialidad y Doctor sin cambios) ... -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 1: Selecciona la Especialidad"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Especialidad">
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteEspecialidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 2: Elige un Doctor"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDoctor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Elige un Doctor"
                android:enabled="false">
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ... (Paso 3 - Selección de Fecha sin cambios) ... -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 3: Elige Fecha y Hora"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeleccionarFecha"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seleccionar Fecha"
                app:icon="@drawable/event_24px"
                app:iconTint="@color/azul_secundario" />
            <TextView
                android:id="@+id/tvFechaSeleccionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/azul_secundario"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                tools:text="Sábado, 26 de Octubre de 2024"/>


            <!-- ✨ INICIO DE LA MEJORA DE HORARIOS (SIN COLORES) ✨ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turno Mañana"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/texto_secundario"
                android:textStyle="bold" />

            <!-- Grupo Mañana (Usando el estilo estándar) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupManana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true">

                <!-- ✨ CAMBIO: Se añadió textAppearanceCaption para reducir el texto -->
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 AM"/>
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:30 AM"/>
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00 AM"/>
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:30 AM"/>
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turno Tarde"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/texto_secundario"
                android:textStyle="bold" />

            <!-- Grupo Tarde (Usando el estilo estándar) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTarde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true">

                <!-- ✨ CAMBIO: Se añadió textAppearanceCaption para reducir el texto -->
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02:00 PM"/>
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02:30 PM"/>
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03:00 PM"/>
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turno Noche"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/texto_secundario"
                android:textStyle="bold" />

            <!-- Grupo Noche (Usando el estilo estándar) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupNoche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true">

                <!-- ✨ CAMBIO: Se añadió textAppearanceCaption para reducir el texto -->
                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00 PM"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- ✨ FIN DE LA MEJORA DE HORARIOS ✨ -->


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 4: Describe tus Síntomas"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Describe brevemente cómo te sientes...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSintomas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ✨ CAMBIO: Se añadió textSize para agrandar el texto del botón -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarCita"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="Confirmar Cita"
                android:textSize="16sp"
                app:cornerRadius="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>